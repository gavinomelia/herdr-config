# Settings for bin/wt. Copy to ~/.config/herdr/wt.env (or point WT_CONFIG at another path).

# The main checkout of the Rails app. Worktrees branch from it and share its git directory.
WT_MAIN=$HOME/Work/my_app

# Database names start with this. The main checkout uses <prefix>_development and <prefix>_test;
# each worktree gets <prefix>_<branch> and <prefix>_test_<branch>.
WT_DB_PREFIX=my_app

# The portless name: the main checkout serves at https://my-app.localhost, a worktree at
# https://<branch>.my-app.localhost
WT_APP=my-app

# Linear team key. With it, `wt new ABC-1234` looks up the issue's branch, and ticket branches
# get short agent names and readable workspace labels. Leave empty to turn that off.
WT_TICKET_PREFIX=abc

# Every worktree's browser signs in as this user (see app/worktree_auto_login.rb). Leave empty
# to sign in by hand.
WT_AUTO_LOGIN_EMAIL=

# What opens in the editor pane of the code layout
WT_EDITOR_COMMAND=nvim

# `wt prune` offers to remove a worktree with no PR after this many days without a commit
WT_IDLE_DAYS=14

# Override these to use your own copies
# WT_PROCFILE=$HOME/.config/herdr/Procfile
# WT_AUTO_LOGIN_SOURCE=$HOME/.config/herdr/worktree_auto_login.rb
